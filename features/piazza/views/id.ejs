<section class="content-section">
    <div class="title">
        <h1><%= thread.title %></h1>
    </div>

    <div class="content">
        <p><%= thread.content %></p>
    </div>

    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %> 
        <div class="admin-control">
            <% if (!thread.isDeleted) { %>
                <button 
                    class="admin-restore-btn" 
                    data-thread-id="<%= thread._id %>" 
                    onclick="handleAdminRestore(this)"
                > Restore Thread </button>
            <% } else { %>
                <button 
                    class="admin-delete-btn" 
                    data-thread-id="<%= thread._id %>" 
                    onclick="handleAdminDelete(this)"
                > Delete Thread </button>
            <% } %>
        </div>
    <% } %>
</section>


<section class="reply">
    <a href="/piazza/<%= thread._id %>/reply" class="btn">Reply</a>

    <div class="replies-list">
        <% if (replies && replies.length > 0) { %>
            <% replies.forEach(function(singleReply) { %>
                <div class="reply-card">
                    <small><strong><%= singleReply.user ? singleReply.user.username: 'Anonymous' %></strong></small>
                    <p><%= singleReply.reply %></p>
                </div>
            <% }) %>
        <% } else { %>
            <p>No replies yet. Be the first to reply!</p>
        <% } %>
    </div>
</section>

<script>
    async function handleAdminDelete(buttonElement) {
        const threadId = buttonElement.getAttribute('data-thread-id');
        const confirmDelete = confirm("Are you sure you want to delete this thread?")

        if (!confirmDelete) return;

        try {
            const response = await fetch(`/piazza/thread/${threadId}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const data = await response.json();

            if (response.ok) {
                alert("Thread successfully soft-deleted");
                window.location.href = '/piazza';
            } else {
                alert(`Error: ${data.message || 'Could not delete thread'}`);
            }
        } catch (error) {
            console.error("Network error:", error);
            alert("A network error occurred. Please try again.")
        }
    }
    async function handleAdminRestore(buttonElement) {
        const threadId = buttonElement.getAttribute('data-thread-id')
        if (!confirm("Are you sure you want to restore this thread to the public feed?")) return;

        try {
            const response = await fetch(`/piazza/thread/${threadId}/restore`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' }
            });

            if (response.ok) {
                alert("Thread successfully restored!");
                window.location.reload();
            } else {
                alert("Could not restore thread.")
            }
        } catch (err) { 
            console.error(err)
        }
    }
</script>